# ---------------------------------------------------------------------------
# Arcadia Estates — live integrations
#
# Copy this file to `.env.local` and fill in what you have. Anything left blank
# stays a demonstration. Restart the dev server after editing.
#
# These values end up in the built JavaScript, which is correct and safe here:
# a scheduler link and a payment link are public by design. NEVER put a Stripe
# secret key (sk_...) in this file — it does not belong in a browser.
# ---------------------------------------------------------------------------

# --- Booking ---------------------------------------------------------------
# 'cal' or 'calendly'. Leave unset for the built-in demonstration diary.
VITE_BOOKING_PROVIDER=
# Just the path: from cal.com/elena/viewing, this is `elena/viewing`.
VITE_BOOKING_LINK=

# --- Payments --------------------------------------------------------------
# 'stripe'. Leave unset for the built-in demonstration checkout.
VITE_PAYMENT_PROVIDER=
# Stripe Dashboard -> Payment links -> New. One per residence, since each
# deposit is a different amount. Paste the whole https://buy.stripe.com/...
VITE_STRIPE_LINK_CASA_AURELIA=
VITE_STRIPE_LINK_RIDGE_HOUSE=
VITE_STRIPE_LINK_VILLA_17=
VITE_STRIPE_LINK_GLASS_HOUSE=
# Used for any residence without its own link above.
VITE_STRIPE_LINK_DEFAULT=
