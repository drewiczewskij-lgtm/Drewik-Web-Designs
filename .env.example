# ---------------------------------------------------------------------------
# KM PRODUCTIONS — ENVIRONMENT
#
# Copy this file to `.env.local` and fill in what you have. Anything left blank
# leaves that feature in demonstration mode, and the site says so on screen
# rather than pretending.
#
# ⚠ EVERYTHING PREFIXED `VITE_` IS COMPILED INTO THE JAVASCRIPT AND IS PUBLIC.
#   A Stripe SECRET key (sk_...) must never appear in this file. It belongs in
#   the server's environment — see the second half of this file.
# ---------------------------------------------------------------------------

# === THE WEBSITE (public values) ==========================================

# Where the booking + payment endpoints live. This one variable switches the
# whole site from demonstration mode to real bookings and real payments.
#   /api                    the server is on the same origin (the usual case)
#   https://api.example/api the server is hosted somewhere else
VITE_API_BASE=

# Optional. Only needed if you later move from Stripe's hosted checkout to an
# embedded card field. Publishable by design — safe here.
VITE_STRIPE_PUBLISHABLE_KEY=

# Where the contact and commercial-quote forms POST. Any service taking a plain
# JSON POST works: Formspree, Basin, a Netlify function, your own handler.
# Leave blank and the forms validate but tell the reader to call instead.
VITE_FORM_ENDPOINT=

# Optional privacy-friendly analytics. Blank means no third-party script loads
# at all, which is why this site has no cookie banner.
VITE_PLAUSIBLE_DOMAIN=


# ===========================================================================
# === THE SERVER (secret values — NEVER prefixed VITE_) =====================
# ===========================================================================
#
# These are read by `api/server.mjs`. Put them in the server's own environment
# (your host's dashboard, a systemd unit, a .env the server loads) — NOT in a
# file that gets bundled into the website.

# Stripe secret key. Start with the TEST key: a test key only ever accepts test
# cards, so you can click the entire flow without moving money.
#   Test:  sk_test_...
#   Live:  sk_live_...
STRIPE_SECRET_KEY=

# From Stripe Dashboard → Developers → Webhooks, after adding an endpoint at
# https://your-site.com/api/webhook listening for:
#   checkout.session.completed
#   checkout.session.expired
# Without this the webhook endpoint rejects everything, and bookings would
# never move from `pending` to `confirmed`.
STRIPE_WEBHOOK_SECRET=

# Your site's public origin. Used to build Stripe's return URLs and to set CORS.
KM_SITE_ORIGIN=https://kmproductions.com

# A long random string. Protects GET /api/admin/bookings, which returns customer
# details. If it is unset the admin endpoint is disabled entirely.
#   Generate one with:  node -e "console.log(crypto.randomUUID())"
KM_ADMIN_TOKEN=

# Where bookings are stored. Must be on a writable, PERSISTENT disk — a
# container filesystem that resets on deploy will lose your diary.
KM_DATA_FILE=./data/bookings.json

# Port for the booking server.
PORT=8787
