{
  "name": "km-productions",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "KM Productions \u2014 real estate photography, videography, drone and commercial production, with online booking and Stripe payments.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "check:images": "node scripts/check-images.mjs",
    "server": "node api/server.mjs",
    "dev:full": "node scripts/dev-full.mjs",
    "build:static": "VITE_ROUTER=hash VITE_BASE=./ npm run build",
    "build:single": "VITE_SINGLE=1 VITE_ROUTER=hash VITE_BASE=./ tsc -b && VITE_SINGLE=1 VITE_ROUTER=hash VITE_BASE=./ vite build && node scripts/bundle-single.mjs",
    "test:booking": "node scripts/test-booking.mjs",
    "link:work": "node scripts/link-work.mjs"
  },
  "dependencies": {
    "lenis": "^1.3.26",
    "motion": "^13.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  }
}
